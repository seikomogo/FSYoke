<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MouseYoke</AssemblyName>
    <RootNamespace>MouseYoke</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>MouseYoke.App</StartupObject>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>MouseYoke</AssemblyTitle>
    <Product>MouseYoke</Product>
    <Description>Mouse-as-yoke flight control overlay for Microsoft Flight Simulator 2024</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Requires the free MSFS SDK to be installed. Its installer sets the MSFS_SDK
    environment variable (e.g. "C:\MSFS 2024 SDK\", trailing backslash included).
    Download: https://docs.flightsimulator.com/msfs2024/html/6_Programming_APIs/SimConnect/SimConnect_SDK.htm

    If your SDK installs to a different layout, either fix the MSFS_SDK env var or
    edit the two paths below directly.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MSFS_SDK)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- Ship the native SimConnect.dll next to the built exe so it doesn't depend on the GAC. -->
  <ItemGroup>
    <None Include="$(MSFS_SDK)SimConnect SDK\lib\SimConnect.dll" Condition="Exists('$(MSFS_SDK)SimConnect SDK\lib\SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SimConnect.dll</Link>
    </None>
  </ItemGroup>

  <!-- Embed the icon into the assembly's resource stream too, so windows can reference it via pack:// without needing the loose file on disk. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    Microsoft.FlightSimulator.SimConnect.dll is a mixed-mode (C++/CLI) assembly, and .NET's
    single-file publish cannot embed mixed-mode assemblies at all - it crashes at startup with
    a BadImageFormatException if left bundled. Both it and the native SimConnect.dll it wraps
    have to ship as loose files next to MouseYoke.exe rather than inside the single file.
  -->
  <Target Name="ExcludeSimConnectFromSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                              Condition="'%(FileName)%(Extension)' == 'Microsoft.FlightSimulator.SimConnect.dll' or '%(FileName)%(Extension)' == 'SimConnect.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
