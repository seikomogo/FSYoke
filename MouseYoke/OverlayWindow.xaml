<Window x:Class="MouseYoke.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseYoke Overlay"
        Width="260" Height="260"
        Left="-10000" Top="-10000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False">
    <Grid>
        <Rectangle Stroke="#B0FFFFFF" StrokeThickness="1.5" Fill="#22FFFFFF" RadiusX="6" RadiusY="6" />
        <Rectangle Width="1" Fill="#90FFFFFF" HorizontalAlignment="Center" />
        <Rectangle Height="1" Fill="#90FFFFFF" VerticalAlignment="Center" />
        <Ellipse Width="8" Height="8" Fill="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
