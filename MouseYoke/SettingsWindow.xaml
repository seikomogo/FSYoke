<Window x:Class="MouseYoke.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseYoke Settings" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Hotkey (toggles the yoke square on/off)" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,8,0"/>
            <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,8,0"/>
            <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,8,0"/>
            <ComboBox x:Name="KeyCombo" Width="80"/>
        </StackPanel>

        <TextBlock Text="Square size (px)" FontWeight="Bold" Margin="0,8,0,4"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                       Text="{Binding ElementName=SquareSizeSlider, Path=Value, StringFormat={}{0:0}}"/>
            <Slider x:Name="SquareSizeSlider" Minimum="120" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="Deadzone" FontWeight="Bold" Margin="0,8,0,4"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                       Text="{Binding ElementName=DeadzoneSlider, Path=Value, StringFormat={}{0:0.00}}"/>
            <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.3" TickFrequency="0.01"/>
        </DockPanel>

        <TextBlock Text="Response curve (1 = linear, higher = softer near center)" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                       Text="{Binding ElementName=CurveSlider, Path=Value, StringFormat={}{0:0.0}}"/>
            <Slider x:Name="CurveSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox x:Name="InvertAileronCheck" Content="Invert aileron" Margin="0,0,12,0"/>
            <CheckBox x:Name="InvertElevatorCheck" Content="Invert elevator"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
